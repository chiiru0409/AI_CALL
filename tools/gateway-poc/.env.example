# ====================================================================
# AI_CALL Voice Gateway Configuration (.env.example)
# Copy this file to .env and provide your actual credentials.
# NOTE: .env is ignored by Git and must never be committed.
# ====================================================================

# --- Twilio Telephony Credentials ---
# Account SID (e.g. ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx)
TWILIO_ACCOUNT_SID=AC00000000000000000000000000000000

# Auth Token (for signature validation) OR API Key Secret
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here

# API Key SID & Secret (created in Twilio Console)
TWILIO_API_KEY_SID=SK00000000000000000000000000000000
TWILIO_API_SECRET=your_twilio_api_secret_here

# Twilio Virtual Phone Number assigned to this gateway (E.164 format)
TWILIO_PHONE_NUMBER=+1234567890

# --- Networking & Public Webhooks ---
# Public URL where Twilio can reach this server (via ngrok, Cloudflare Tunnel, or VPS)
# Example: https://myapp.ngrok-free.app
GATEWAY_BASE_URL=https://your-domain.ngrok-free.app

# Set to 'true' in production to enforce cryptographic Twilio-Signature verification
VALIDATE_TWILIO_SIGNATURE=false

# Host & Port for local server binding
SERVER_HOST=0.0.0.0
SERVER_PORT=8000

# --- Android Mobile App Integration ---
# Shared bearer token / API key required for AI_CALL Android app requests
GATEWAY_API_KEY=aicall_gateway_secret_token_change_me

# --- AI Agent Identity & Operating Parameters ---
AGENT_NAME="AI Personal Assistant"
OWNER_NAME="Chiru"
DEFAULT_LANGUAGE=en-IN
MAX_CONVERSATION_TURNS=15
RECORDING_ENABLED=false

# --- AI Provider Configuration ---
# Options: 'mock', 'gemini'
LLM_PROVIDER=mock
GEMINI_API_KEY=

# Options: 'mock', 'deepgram'
STT_PROVIDER=mock
DEEPGRAM_API_KEY=

# Options: 'builtin', 'edge_tts'
TTS_PROVIDER=builtin
